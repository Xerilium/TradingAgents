{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TradingAgents",
  "version": "0.6.1",
  "identifier": "com.tradingagents.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "resources": {
      "payload/": "payload/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "zlib"
      }
    }
  }
}
